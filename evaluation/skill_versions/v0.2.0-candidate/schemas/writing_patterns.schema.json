{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rce/writing_patterns.schema.json",
  "title": "Writing patterns and anti-patterns (moves, not prose)",
  "type": "object",
  "required": ["patterns"],
  "properties": {
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "section", "rhetorical_purpose", "move_sequence", "reader_question_answered", "paraphrase_only"],
        "properties": {
          "id": {"type": "string", "pattern": "^(PAT|ANT)-[0-9]{3,}$"},
          "source": {"type": "string"},
          "section": {"type": "string"},
          "rhetorical_purpose": {"type": "string"},
          "move_sequence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "reader_question_answered": {"type": "string"},
          "assumed_knowledge": {"type": "string"},
          "transition_behavior": {"type": "string"},
          "evidence_placement": {"type": "string"},
          "result_interpretation_pattern": {"type": ["string", "null"]},
          "figure_table_integration": {"type": ["string", "null"]},
          "limitation_framing": {"type": ["string", "null"]},
          "contribution_framing": {"type": ["string", "null"]},
          "signature": {"type": "string"},
          "reader_effect": {"type": "string"},
          "repair_principle": {"type": "string"},
          "paraphrase_only": {"type": "boolean"},
          "quote": {"type": "string", "maxLength": 200},
          "quote_permitted": {"type": "boolean"}
        }
      }
    }
  }
}
