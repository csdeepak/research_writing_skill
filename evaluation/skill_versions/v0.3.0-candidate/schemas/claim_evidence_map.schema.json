{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rce/claim_evidence_map.schema.json",
  "title": "Claim-evidence graph",
  "type": "object",
  "required": [
    "claims",
    "limitations"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "claim_type",
          "evidence",
          "confidence",
          "author_confirmation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[0-9]{3,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 5
          },
          "claim_type": {
            "enum": [
              "measured",
              "observed",
              "derived",
              "literature",
              "interpretation",
              "hypothesis",
              "speculation",
              "future"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(E[0-9]{3,}|C[0-9]{3,})$"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SRC-[0-9]{3,}$"
            }
          },
          "scope": {
            "type": [
              "object",
              "string"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "moderate",
              "low"
            ]
          },
          "confidence_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^L[0-9]{3,}$"
            }
          },
          "negative_results": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E[0-9]{3,}$"
            }
          },
          "permitted_verbs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "author_confirmation": {
            "enum": [
              "confirmed",
              "pending",
              "rejected"
            ]
          },
          "used_in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "origin": {
            "enum": [
              "author_stated",
              "writer_derived"
            ],
            "description": "Who asserts this: the authors' own materials (author_stated, quote in evidence) or the writing agent (writer_derived). Required when 'rationale' is set."
          },
          "rationale": {
            "enum": [
              "motivation",
              "design_choice"
            ],
            "description": "Set on claims that carry the authors' stated motivation (Q2) or reason for a design choice (Q5). Must be origin author_stated and cite a rationale_stated evidence item."
          },
          "basis": {
            "enum": [
              "project_file",
              "code",
              "user_confirmed",
              "literature",
              "none"
            ],
            "description": "v0.3 provenance axis (separate from claim_type): where the claim's support comes from. measured/observed/derived with basis 'none' is UNSUPPORTED_FACT."
          },
          "status": {
            "enum": [
              "VERIFIED",
              "NEEDS_REVIEW",
              "BLOCKED"
            ],
            "description": "v0.3: BLOCKED claims may not appear in the draft (lint BLOCKED-claim-used)."
          },
          "licenses": {
            "type": "array",
            "description": "v0.3 evidence-conditional language (spec 4.2). A claim that uses e.g. 'significant' needs a significance_test license backed by qualifying evidence. Presence of this key (even []) switches the lint to fail-closed.",
            "items": {
              "type": "object",
              "required": [
                "type",
                "evidence"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "significance_test",
                    "sota_comparison",
                    "stress_test",
                    "latency_measured",
                    "clinical_study",
                    "ood_eval",
                    "literature_search",
                    "causal_design",
                    "matched_evaluation",
                    "complete_enumeration"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^E[0-9]{3,}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "affects_claims",
          "origin"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^L[0-9]{3,}$"
          },
          "statement": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "author_stated",
              "writer_derived"
            ],
            "description": "author_stated: the authors concede it in their own materials (must cite a limitation_noted evidence item). writer_derived: a caveat the writing agent inferred (reported separately as an additional caveat, never in the authors' voice as their concession)."
          },
          "affects_claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^C[0-9]{3,}$"
            }
          },
          "effect_on_interpretation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resolution": {
            "type": "string"
          }
        }
      }
    },
    "negative_result_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence",
          "decision"
        ],
        "properties": {
          "evidence": {
            "type": "string",
            "pattern": "^E[0-9]{3,}$"
          },
          "decision": {
            "enum": [
              "reported_main",
              "reported_supplement",
              "excluded"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}