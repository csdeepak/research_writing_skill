# Copy to .env (never committed) and export before running tools/rce_llm.py or tools/rce_roles.py.
# Bind roles to these variables with "api_key_env" in .rcs/models.json. Only set what you use.
# Hosted endpoints must also be listed in data_policy.allowed_hosts (docs/PRIVACY.md).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: CA bundle for TLS-intercepting networks
RCE_CA_FILE=
# Optional, for the literature tools (lit_search.py, verify_citations.py). Read from the environment only.
# RCE_CONTACT_EMAIL is sent in the User-Agent header, for the indexes' polite pools.
RCE_CONTACT_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
