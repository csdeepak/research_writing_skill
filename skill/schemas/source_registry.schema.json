{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rce/source_registry.schema.json",
  "title": "External source registry",
  "type": "object",
  "required": [
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "authors",
          "year",
          "publication_status",
          "level",
          "verification",
          "read_depth",
          "permitted_use"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SRC-[0-9]{3,}$"
          },
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "year": {
            "type": "integer",
            "minimum": 1600,
            "maximum": 2100
          },
          "venue": {
            "type": [
              "string",
              "null"
            ]
          },
          "doi": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^10\\.[0-9]{4,9}/\\S+$"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "publication_status": {
            "enum": [
              "PEER-REVIEWED",
              "PREPRINT",
              "EDITORIAL",
              "GUIDELINE",
              "TECHNICAL_REPORT",
              "BLOG",
              "DOCUMENTATION",
              "COMMENTARY",
              "OPINION"
            ]
          },
          "peer_review_known": {
            "type": "boolean"
          },
          "domain": {
            "type": "string"
          },
          "paper_type": {
            "type": "string"
          },
          "level": {
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "verification": {
            "type": "object",
            "required": [
              "method",
              "date"
            ],
            "properties": {
              "method": {
                "enum": [
                  "doi_lookup",
                  "index_lookup",
                  "publisher_page",
                  "user_supplied_file",
                  "manual"
                ]
              },
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "verified_by": {
                "enum": [
                  "agent",
                  "human"
                ]
              },
              "retraction_checked": {
                "type": "boolean"
              },
              "lookup_verified": {
                "enum": [
                  true,
                  false,
                  "unresolvable"
                ],
                "description": "v0.5 (skill/literature.md section 5.2): true = found by lookup; false = the ID provably fails or names a different work (fabrication evidence); unresolvable = no index could confirm it (a coverage gap). Absent = no verdict yet."
              },
              "code": {
                "enum": [
                  null,
                  "NO_CITED_TITLE",
                  "DOI_MISMATCH",
                  "ID_NOT_FOUND",
                  "NO_TITLE_TO_COMPARE",
                  "NOT_INDEXED",
                  "LOOKUP_DEGRADED",
                  "NO_IDENTIFIER"
                ]
              },
              "indexes": {
                "type": "array",
                "description": "v0.5: one row per index consulted. 'skipped' means no answer, never 'not found'.",
                "items": {
                  "type": "object",
                  "required": [
                    "index",
                    "status"
                  ],
                  "properties": {
                    "index": {
                      "enum": [
                        "doi.org",
                        "crossref",
                        "openalex",
                        "semantic_scholar",
                        "arxiv"
                      ]
                    },
                    "status": {
                      "enum": [
                        "found",
                        "not_found",
                        "skipped"
                      ]
                    },
                    "match_score": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              },
              "conflicts": {
                "type": "array",
                "description": "v0.5: disagreements between index records, recorded and never resolved by the tool",
                "items": {
                  "type": "object",
                  "required": [
                    "field",
                    "values"
                  ],
                  "properties": {
                    "field": {
                      "enum": [
                        "year",
                        "first_author",
                        "title",
                        "first_author_cited"
                      ]
                    },
                    "values": {
                      "type": "object"
                    },
                    "minor": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "suggestion": {
                "type": "object",
                "description": "v0.5: a similar record an index holds, for a person to consider. Never applied automatically.",
                "properties": {
                  "index": {
                    "type": "string"
                  },
                  "doi": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "year": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "read_depth": {
            "enum": [
              "full",
              "partial",
              "abstract"
            ]
          },
          "establishes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "statement",
                "support_quote",
                "location"
              ],
              "properties": {
                "statement": {
                  "type": "string"
                },
                "support_quote": {
                  "type": "string",
                  "maxLength": 400
                },
                "location": {
                  "type": "string"
                },
                "strength": {
                  "type": "string"
                }
              }
            }
          },
          "why_useful": {
            "type": "string"
          },
          "demonstrates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "informs_sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_quality": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "v0.5: graded for the claim the source is cited for (skill/literature.md section 6)"
          },
          "limitations": {
            "type": "string"
          },
          "permitted_use": {
            "type": "array",
            "items": {
              "enum": [
                "content_citation",
                "pattern_exemplar",
                "negative_pattern",
                "venue_rule"
              ]
            }
          },
          "citation_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "as_cited": {
            "type": "string",
            "description": "v0.3: the title exactly as the project's own materials cite it. A different 'title' without a doi/index/publisher lookup is TITLE_REPAIRED_FROM_MEMORY."
          },
          "title_status": {
            "enum": [
              "verified",
              "as_cited",
              "unverifiable"
            ]
          },
          "arxiv_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "retraction": {
            "type": "object",
            "required": [
              "status",
              "checked_at"
            ],
            "description": "v0.5 (skill/literature.md section 5.3): what named resolvers returned on a date. Matched on DOI only.",
            "properties": {
              "status": {
                "enum": [
                  "retracted",
                  "not_retracted",
                  "disputed",
                  "unknown"
                ]
              },
              "checked_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
              },
              "source": {
                "type": "string"
              },
              "observations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "source",
                    "retracted"
                  ],
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "retracted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "flags": {
            "type": "array",
            "description": "v0.5: what a person should look at; a flag is not a verdict (skill/literature.md section 5.4)",
            "items": {
              "enum": [
                "preprint",
                "single_index",
                "post_llm_unconfirmed",
                "metadata_conflict",
                "expression_of_concern",
                "predatory_suspected",
                "retracted_acknowledged"
              ]
            }
          }
        }
      }
    }
  }
}
