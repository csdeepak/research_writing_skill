{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rce/reviewer_cards.schema.json",
  "title": "Reviewer cards from the field analyst (diagnostics/<round>/panel/cards.json; skill/review_panel.md section 2)",
  "type": "object",
  "required": ["field", "article_type", "cards"],
  "properties": {
    "field": {"type": "string", "minLength": 2},
    "subfield": {"type": "string"},
    "venue": {"type": ["string", "null"]},
    "article_type": {"type": "string"},
    "criteria_source": {"type": "string", "description": "the venue's published criteria, or the rubric and paper type used instead"},
    "cards": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["seat", "criteria", "serious_failure"],
        "properties": {
          "seat": {"enum": ["journal_fit", "methodology", "domain", "perspective", "devils_advocate"]},
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "criterion"],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Z]{2,3}[0-9]+$"},
                "criterion": {"type": "string", "minLength": 5}
              }
            }
          },
          "serious_failure": {"type": "string", "minLength": 5, "description": "what would count as a serious failure for this seat, in this field"}
        }
      }
    }
  }
}
