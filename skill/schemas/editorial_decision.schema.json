{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rce/editorial_decision.schema.json",
  "title": "Editorial decision and revision roadmap (diagnostics/<round>/editorial_decision.json; skill/review_panel.md sections 5 and 8)",
  "description": "The SYNTHESIZER merges seat reports. It adds no findings and no claims. tools/panel_check.py re-derives the decision from the findings and fails a mismatch.",
  "type": "object",
  "required": ["kind", "decision", "roadmap"],
  "properties": {
    "kind": {"enum": ["full", "verification"]},
    "previous_round": {"type": ["string", "null"], "description": "verification only: the round whose roadmap is being checked"},
    "decision": {"enum": ["accept", "minor", "major", "reject"]},
    "basis": {"type": "string", "description": "which findings or checks decide it"},
    "merged": {
      "type": "array",
      "items": {"type": "object", "required": ["finding_ids"],
                "properties": {"finding_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "note": {"type": "string"}}}
    },
    "downgrades": {
      "type": "array",
      "description": "a severity lowered by the synthesizer, which must quote what in the paper refutes it",
      "items": {"type": "object", "required": ["finding_id", "to", "quote"],
                "properties": {"finding_id": {"type": "string"}, "to": {"enum": ["major", "minor", "withdrawn"]},
                               "quote": {"type": "string", "minLength": 5, "maxLength": 300}, "location": {"type": "object"}}}
    },
    "dissent": {
      "type": "array",
      "items": {"type": "object", "required": ["note"],
                "properties": {"finding_ids": {"type": "array", "items": {"type": "string"}}, "seats": {"type": "array", "items": {"type": "string"}},
                               "note": {"type": "string", "minLength": 5}}}
    },
    "roadmap": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from_findings", "priority", "goal"],
        "properties": {
          "id": {"type": "string", "pattern": "^R-[0-9]+$"},
          "from_findings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "priority": {"enum": ["blocking", "optional"]},
          "location": {"type": "object"},
          "goal": {"type": "string", "minLength": 5}
        }
      }
    }
  }
}
